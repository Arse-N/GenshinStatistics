<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="93dp"
        android:background="@color/milk"
        tools:context=".ui.statistic.StatisticFragment">

    <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            android:id="@+id/statistics_filtering_layout"
            android:translationZ="10dp"
            app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
                android:layout_width="wrap_content"
                android:orientation="horizontal"
                android:layout_height="30dp"
                android:id="@+id/statisticType_linearlayout"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="15dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/filter_bg"
                android:layout_weight="5">
            <TextView
                    android:text="@string/filter_by"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/charachter_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="15dp"
                    android:textColor="@color/very_light_gold"
                    android:layout_gravity="center"/>
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end">
                <LinearLayout
                        android:id="@+id/statistic_type_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/spinner_bg"
                        android:orientation="horizontal">
                    <Spinner
                            android:id="@+id/statistic_type_selector"
                            android:layout_width="wrap_content"
                            android:maxWidth="160dp"
                            android:layout_height="match_parent"
                            android:paddingStart="15dp"
                            android:paddingEnd="15dp"
                            android:clickable="false"
                            android:background="@android:color/transparent"
                            android:popupBackground="@color/milk"
                            android:popupTheme="@style/secondaryTextColor"
                            android:spinnerMode="dropdown"
                            android:textColor="@android:color/black"
                            android:textStyle="bold">
                    </Spinner>
                    <LinearLayout

                            android:id="@+id/statistic_arrow_down_layout"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:orientation="horizontal"
                            android:gravity="end">
                        <ImageButton
                                android:src="@drawable/ic_arrow_down"
                                android:background="@android:color/transparent"
                                android:layout_width="25dp"
                                android:layout_height="25dp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="10dp"
                                android:id="@+id/statistic_type_arrow"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <ImageButton
                android:src="@drawable/ic_filter"
                android:background="@drawable/round_button_bg"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:id="@+id/filterButton"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/statistics_layout"
            android:visibility="visible"
            android:background="@color/milk"
            app:layout_constraintTop_toBottomOf="@+id/statistics_filtering_layout">
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:id="@+id/buttons_line"
                android:layout_marginTop="10dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            <Button
                    android:id="@+id/character"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/ic_statistics_button_bg"
                    android:gravity="center"
                    android:text="Character"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    style="@style/primaryTextColor"
                    tools:ignore="RtlCompat"/>
            <Button
                    android:id="@+id/standard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/ic_statistics_button_bg"
                    android:gravity="center"
                    android:text="Standard"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    style="@style/primaryTextColor"
                    tools:ignore="RtlCompat"/>
            <Button
                    android:id="@+id/chronical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/ic_statistics_button_bg"
                    android:gravity="center"
                    android:text="Chronical"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    style="@style/primaryTextColor"
                    tools:ignore="RtlCompat"/>
            <Button
                    android:id="@+id/weapon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="15dp"
                    android:background="@drawable/ic_statistics_button_bg"
                    android:gravity="center"
                    android:text="Weapon"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:textAlignment="center"
                    style="@style/primaryTextColor"
                    tools:ignore="RtlCompat"/>
        </LinearLayout>
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/wish_statistics_header"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/buttons_line">
            <TextView
                    android:id="@+id/all_time_pulls_title"
                    android:text="Characther Banner Statistics"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginStart="15dp"
                    android:textSize="16sp"
                    android:gravity="center_horizontal"
                    style="@style/primaryTextColor"
                    android:layout_weight="1"/>

        </LinearLayout>
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:id="@+id/banner_wish_statistics"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/wish_statistics_header">
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/primogems"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/ic_statistic_item_bg_half_size"
                    android:layout_weight="5"
                    android:gravity="center_horizontal">
                <TextView
                        android:id="@+id/total_pulls_title"
                        android:text="Total Pulls:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:layout_marginStart="5dp"
                        style="@style/secondaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="4"
                        tools:ignore="RtlCompat"/>
                    <TextView
                            android:id="@+id/total_pulls_value"
                            android:text="10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            style="@style/primaryTextColor"
                            android:layout_gravity="center_vertical"
                            android:layout_weight="6"
                            tools:ignore="RtlCompat"/>

                    <ImageView
                            android:layout_width="25dp"
                            android:layout_height="25dp"
                            android:layout_gravity="center_vertical"
                            app:srcCompat="@drawable/ic_wish_pull"
                            android:id="@+id/primogem_icon"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"/>
                </LinearLayout>
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/wish_pulls"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/ic_statistic_item_bg_half_size"
                    android:gravity="center_horizontal"
                    android:layout_weight="4">
                <TextView
                        android:id="@+id/pity_count_title"
                        android:text="Pity count:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:layout_marginStart="5dp"
                        style="@style/secondaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="4"
                        tools:ignore="RtlCompat"/>
                <TextView
                        android:id="@+id/pity_count_value"
                        android:text="10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        style="@style/primaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="6"
                        tools:ignore="RtlCompat"/>

                <ImageView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center_vertical"
                        app:srcCompat="@drawable/ic_wish_pull"
                        android:id="@+id/wish_pulls_icon"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"/>
                </LinearLayout>
        </LinearLayout>
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:id="@+id/fifty_50_wins_loses_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/banner_wish_statistics">
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/fifty_50_loses_layout"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/ic_statistic_item_bg_half_size"
                    android:layout_weight="1"
                    android:gravity="center_horizontal">
                <TextView
                        android:id="@+id/fifty_50_loses_title"
                        android:text="50/50 Loses:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:layout_marginStart="5dp"
                        style="@style/secondaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        tools:ignore="RtlCompat"/>
                <TextView
                        android:id="@+id/fifty_50_loses_value"
                        android:text="10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        style="@style/primaryTextColor"
                        android:textColor="@color/rarity_v5"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        tools:ignore="RtlCompat"/>
            </LinearLayout>
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/fifty_50_wins_layout"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/ic_statistic_item_bg_half_size"
                    android:gravity="center_horizontal"
                    android:layout_weight="1">
                <TextView
                        android:id="@+id/fifty_50_wins_title"
                        android:text="50/50 Wins:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:layout_marginStart="5dp"
                        style="@style/secondaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        tools:ignore="RtlCompat"/>
                <TextView
                        android:id="@+id/fifty_50_wins_value"
                        android:text="10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        style="@style/primaryTextColor"
                        android:textColor="@color/rarity_v1"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        tools:ignore="RtlCompat"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:id="@+id/fifty_50_wins_loses_strike_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fifty_50_wins_loses_layout">
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/fifty_50_loses_strike_layout"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/ic_statistic_item_bg_half_size"
                    android:layout_weight="1"
                    android:gravity="center_horizontal">
                <TextView
                        android:id="@+id/fifty_50_loses_strike_title"
                        android:text="Loses strike record:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:layout_marginStart="5dp"
                        style="@style/secondaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        tools:ignore="RtlCompat"/>
                <TextView
                        android:id="@+id/fifty_50_loses_strike_value"
                        android:text="10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        style="@style/primaryTextColor"
                        android:textColor="@color/rarity_v5"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        tools:ignore="RtlCompat"/>
            </LinearLayout>
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/fifty_50_wins_strike_layout"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/ic_statistic_item_bg_half_size"
                    android:gravity="center_horizontal"
                    android:layout_weight="1">
                <TextView
                        android:id="@+id/fifty_50_wins_strike_title"
                        android:text="Wins strike record:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:layout_marginStart="5dp"
                        style="@style/secondaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        tools:ignore="RtlCompat"/>
                <TextView
                        android:id="@+id/fifty_50_wins_strike_value"
                        android:text="10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        style="@style/primaryTextColor"
                        android:textColor="@color/rarity_v1"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        tools:ignore="RtlCompat"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:id="@+id/fifty_50_wins_loses_current_strike_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fifty_50_wins_loses_strike_layout">
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/fifty_50_loses_wins_strike_current_layout"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/ic_statistic_item_bg_half_size"
                    android:layout_weight="1"
                    android:gravity="center_horizontal">
                <TextView
                        android:id="@+id/fifty_50_loses_wins_strike_current_title"
                        android:text="Current 50/50 win strike:"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="12sp"
                        android:layout_marginStart="5dp"
                        style="@style/secondaryTextColor"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        tools:ignore="RtlCompat"/>
                <TextView
                        android:id="@+id/fifty_50_loses_wins_strike_current_value"
                        android:text="10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:textSize="16sp"
                        style="@style/primaryTextColor"
                        android:textColor="@color/rarity_v5"
                        android:layout_gravity="center_vertical"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        tools:ignore="RtlCompat"/>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/charts_layout"
            android:visibility="gone"
            android:background="@color/milk"
            app:layout_constraintTop_toBottomOf="@+id/statistics_filtering_layout">

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/wish_chart_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toTopOf="parent">

            <!-- Square PieChart Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/fifty_fifty_win"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/ic_chart_bg"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/fifty_fifty_win_strike"
                    app:layout_constraintDimensionRatio="1:1">
                <TextView
                        android:id="@+id/fifty_50_pie_chart_title"
                        android:text="50/50% wins/loses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        style="@style/primaryTextColor"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChart"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp"
                        android:layout_marginBottom="5dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/fifty_50_pie_chart_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Square Value Display Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/fifty_fifty_win_strike"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/ic_chart_bg"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/fifty_fifty_win"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintDimensionRatio="1:1">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                            android:id="@+id/fifty_50_wins_strike_title_1"
                            android:text="@string/fifty_50_wins_strike"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:layout_marginTop="10dp"
                            style="@style/secondaryTextColor"/>

                    <TextView
                            android:id="@+id/fifty_50_wins_strike_value_1"
                            android:text="10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:textSize="30sp"
                            android:layout_marginBottom="10dp"
                            style="@style/primaryTextColor"/>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/functional_chart"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="7:6"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/ic_chart_bg"
                app:layout_constraintTop_toBottomOf="@+id/wish_chart_layout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/big_chart_layout"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                <TextView
                        android:id="@+id/big_chart_title"
                        android:text="Wish pull statistics chart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        style="@style/primaryTextColor"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="15dp"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>
                <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/big_chart_filter_layout"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="5dp"
                        android:layout_marginEnd="10dp"
                        android:gravity="end"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                            android:src="@drawable/ic_filter"
                            android:background="@drawable/round_button_bg"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:id="@+id/chartFilterButton"
                            android:layout_gravity="end"/>
                </LinearLayout>
            </LinearLayout>

            <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/big_chart_layout"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/grid_layout"
            android:translationZ="10dp"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@+id/statistics_filtering_layout"
            app:layout_constraintStart_toStartOf="parent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent">
        <GridView
                android:id="@+id/owned_items"
                android:layout_height="wrap_content"
                android:layout_width="wrap_content"
                android:numColumns="3"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>